# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS.
# Leave empty when the frontend is served by this same Express server (default setup).
CORS_ORIGIN=
# Public URL of the app, used for links inside emails
APP_URL=http://localhost:3000

# ─── Database (MongoDB Atlas) ─────────────────────────────
# Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goodneighbor?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────
# Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ─── Gemini (AI planning assistant + receipt analysis) ────
# Get a key at https://aistudio.google.com/apikey  (leave empty to disable AI features)
GEMINI_API_KEY=
# Any current Gemini Flash model name; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
# Set to true to let Gemini pre-read payment receipts (hosts still confirm manually)
GEMINI_RECEIPT_ANALYSIS=false
# Max AI planning requests per user per hour
AI_REQUESTS_PER_HOUR=20

# ─── Gmail API (email notifications) ──────────────────────
# Leave empty to disable email; in-app notifications always work.
# See README → "Gmail API setup", then run:  npm run gmail-auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail address that authorised the app (the "From" address)
GMAIL_SENDER=
GMAIL_SENDER_NAME=GoodNeighbor Health

# Optional: DNS servers for Node to use if mongodb+srv lookups fail with querySrv ECONNREFUSED
# DNS_SERVERS=8.8.8.8,1.1.1.1
